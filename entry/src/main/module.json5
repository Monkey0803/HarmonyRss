{
  "module": {
    "name": "entry",
    "type": "entry",
    "description": "$string:module_desc",
    "mainElement": "EntryAbility",
    "deviceTypes": [
      "phone",
      "tablet"
    ],
    "deliveryWithInstall": true,
    "installationFree": false,
    "pages": "$profile:main_pages",
    // 分享目标用 canOpenLink 预判是否已安装：scheme 必须在此声明，否则接口会抛错。
    "querySchemes": [
      "pocket",
      "instapaper",
      "flomo",
      "mailto"
    ],
    "metadata": [
      {
        "name": "ohos.arkui.UIMaterial.state",
        "value": "enable"
      },
      {
        "name": "ohos.net.network_security_config",
        "resource": "$profile:network_config"
      }
    ],
    // 权限申请原则：只声明「系统授权即可、运行时不弹窗」的 normal / system_grant 权限。
    // - 通知：不需要 manifest 权限，走运行时 requestEnableNotification（见 NotifySettingsView）。
    // - 后台抓取：WorkSchedulerExtensionAbility 由系统调度，无独立权限。
    // - 文件 / 相册：备份导出与背景图都通过系统 picker + 应用沙箱，不申请存储 / 媒体权限。
    // - 剪贴板：只在 PasteButton 点击时读取，不后台读取。
    "requestPermissions": [
      // 订阅抓取 / 正文 / 图片 / 翻译 / 远端同步。
      {
        "name": "ohos.permission.INTERNET"
      },
      // 隐私页展示在线 / 离线状态（只读查询，normal + system_grant）。
      {
        "name": "ohos.permission.GET_NETWORK_INFO"
      },
      // 智感握姿（系统手势检测，normal + system_grant）。
      {
        "name": "ohos.permission.DETECT_GESTURE"
      },
      // 防窥保护（读取系统防窥状态）。
      {
        "name": "ohos.permission.DLP_GET_HIDE_STATUS"
      }
    ],
    "abilities": [
      {
        "name": "EntryAbility",
        "srcEntry": "./ets/entryability/EntryAbility.ets",
        "description": "$string:EntryAbility_desc",
        "icon": "$media:layered_image",
        "label": "$string:EntryAbility_label",
        "startWindowIcon": "$media:startIcon",
        "startWindowBackground": "$color:start_window_background",
        "exported": true,
        "skills": [
          {
            "entities": [
              "entity.system.home"
            ],
            "actions": [
              "ohos.want.action.home"
            ]
          },
          {
            "actions": [
              "ohos.want.action.sendData",
              "ohos.want.action.viewData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.plain-text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.object",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ],
    "extensionAbilities": [
      {
        "name": "RssWorkScheduler",
        "srcEntry": "./ets/workscheduler/RssWorkScheduler.ets",
        "type": "workScheduler",
        "exported": false,
        "description": "$string:work_scheduler_desc"
      },
      {
        "name": "RssWidgetAbility",
        "srcEntry": "./ets/form/RssWidgetAbility.ets",
        "type": "form",
        "exported": true,
        "description": "$string:widget_desc",
        "metadata": [
          {
            "name": "ohos.extension.form",
            "resource": "$profile:form_config"
          }
        ]
      },
      {
        "name": "ShareAbility",
        "srcEntry": "./ets/shareability/ShareAbility.ets",
        "type": "share",
        "exported": true,
        "description": "$string:share_ability_desc",
        "metadata": [
          {
            "name": "ohos.extension.share",
            "resource": "$profile:share_config"
          }
        ],
        "skills": [
          {
            "actions": [
              "ohos.want.action.sendData"
            ],
            "uris": [
              {
                "scheme": "file",
                "utd": "general.hyperlink",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.plain-text",
                "maxFileSupported": 1
              },
              {
                "scheme": "file",
                "utd": "general.text",
                "maxFileSupported": 1
              }
            ]
          }
        ]
      }
    ]
  }
}
