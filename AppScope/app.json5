{
  "app": {
    "bundleName": "com.xiaohuihu.rss",
    "vendor": "example",
    "versionCode": 1000000,
    "versionName": "1.0.0",
    "icon": "$media:layered_image",
    "alternateIcons": [
      { "name": "aurora", "icon": "$media:layered_image_aurora" },
      { "name": "sunset", "icon": "$media:layered_image_sunset" },
      { "name": "mono", "icon": "$media:layered_image_mono" }
    ],
    "label": "$string:app_name",
    // 端云文件协同：系统按此开关为应用准备 el2/cloud，「云空间备份」才能读写；
    // 缺省为 false，漏配时 context.cloudFileDir 目录不存在，页面会误报「设备不可用」。
    "cloudFileSyncEnabled": true,
    // 关系型数据库端云同步：用户在「设置 > 云空间」可见应用开关，可自行关闭。
    "cloudStructuredDataSyncEnabled": true
  }
}
